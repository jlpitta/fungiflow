manifest {
    name        = 'fungiflow'
    version     = '0.1.0'
    description = 'Long-Read Genome Assembly Pipeline (fungal, fork of bacflow)'
    author      = 'jlpitta'
    nextflowVersion = '>=23.04.0'
}

params {
    // Input
    samplesheet     = null
    long_reads      = null
    short_reads_1   = null
    short_reads_2   = null
    sample_name     = 'sample'
    genome_size     = null

    // Mode
    mode            = 'denovo'

    // Polishing
    use_racon         = false
    polisher          = 'polypolish'  // polypolish (default), nextpolish, none
    nextpolish_rounds = 1             // apenas para --polisher nextpolish

    // Platform
    platform        = 'mgicyclone'
    medaka_model    = null   // definido pelo platform; sobrescreve com --medaka_model
    flye_mode       = null   // definido pelo platform; sobrescreve com --flye_mode

    // Filtering
    min_quality     = 10
    min_length      = 500
    downsample      = 0

    // Reference
    reference       = null

    // QC de montagem (BUSCO — só roda quando reference == null)
    busco_lineage   = 'bacteria_odb10'

    // QC de montagem (CheckM2 — completude + contaminação, roda sempre)
    checkm2_db      = "${System.getenv('HOME')}/checkm2_db/CheckM2_database/uniref100.KO.1.dmnd"

    // Anotação (Bakta — roda sempre, na montagem final)
    bakta_db        = "${System.getenv('HOME')}/bakta_db/db"

    // Taxonomia (GTDB-Tk — roda sempre, na montagem final)
    // Nome da pasta muda por release (ex: release232) — atualizar aqui quando
    // o banco for atualizado no futuro.
    gtdbtk_db       = "${System.getenv('HOME')}/gtdbtk_db/release232"

    // AMR (AMRFinderPlus — roda sempre, na montagem final; banco próprio,
    // independente do embutido no Bakta)
    amrfinder_db    = "${System.getenv('HOME')}/amrfinder_db/latest"

    // Ploidia/heterozigose (pré-montagem, decide parâmetro do montador) — delega
    // pro ploidycheck externo (github.com/jlpitta/ploidycheck), instalado como
    // dependência sibling por install_envs.sh
    ploidycheck_bin         = "${projectDir}/../ploidycheck/ploidycheck"
    ploidycheck_env         = 'ploidycheck' // nome do ambiente conda/mamba do ploidycheck (não é o fungiflow-ploidy antigo)
    ploidy_smudge_l         = 7     // cutoff -L do Smudgeplot; NÃO usar o valor sugerido automaticamente (ver README do ploidycheck)
    ploidy_ab_threshold     = 0.5   // fração mínima da smudge AB para considerar heterozigose plausível
    ploidy_coverage_tolerance = 0.3 // erro relativo máximo entre a cobertura 1n do Smudgeplot e o kmercov do GenomeScope2

    // Resources
    t               = 8
    outdir          = 'results'

    // Help
    help            = false
}

conda.enabled  = true
conda.useMamba = true

executor {
    name = 'local'
    cpus = Math.min(params.t as int, Runtime.runtime.availableProcessors())
}

process {
    cache = 'lenient'

    withLabel: 'process_low' {
        cpus = { Math.max(1, (Math.min(params.t as int, Runtime.runtime.availableProcessors()) / 4).toInteger()) }
    }
    withLabel: 'process_medium' {
        cpus = { Math.max(1, (Math.min(params.t as int, Runtime.runtime.availableProcessors()) / 2).toInteger()) }
    }
    withLabel: 'process_high' {
        cpus = { Math.min(params.t as int, Runtime.runtime.availableProcessors()) }
    }
}

profiles {
    conda      { conda.useMamba = false }
    mamba      { /* default */ }
    micromamba { conda.mambaBin = 'micromamba' }
}
